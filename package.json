{
  "name": "techshopapi",
  "version": "2.0.0",
  "description": "API for techShop",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "preview": "NODE_ENV=production npm run build && npm run start ",
    "seed": "kysely seed:run",
    "seed:run": "kysely seed:run --specific",
    "migrate": "kysely migrate:latest",
    "migrate:rollback": "kysely migrate:rollback --all",
    "migrate:refresh": "npm run migrate:rollback && npm run migrate",
    "migrate:make": "kysely migrate:make",
    "migrate:pr:latest": "node dist/boot/database/run/migrateToLatest.js",
    "migrate:pr:rollback": "node dist/boot/database/run/oneStepRollback.js",
    "test": "vitest",
    "test:run": "vitest run",
    "docs:generate": "tsx src/boot/docs/generate.ts"
  },
  "author": "mich",
  "license": "ISC",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.0.0",
    "@types/pino": "^7.0.4",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jose": "^6.2.3",
    "kysely": "^0.28.11",
    "mariadb": "^3.4.5",
    "mysql2": "^3.16.3",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "slug": "^11.0.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.1",
    "@types/node-jose": "^1.1.13",
    "@types/pg": "^8.16.0",
    "@types/slug": "^5.0.9",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/typescript": "^0.4.29",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "jiti": "^2.6.1",
    "kysely-ctl": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.1.5"
  }
}
