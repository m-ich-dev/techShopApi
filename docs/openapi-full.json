{
  "openapi": "3.0.0",
  "info": {
    "title": "techshopapi",
    "version": "2.0.0",
    "description": "API for techShop"
  },
  "servers": [
    {
      "url": "http://localhost:3030/api/v1"
    }
  ],
  "tags": [
    {
      "name": "store",
      "description": "Storefront API"
    },
    {
      "name": "auth",
      "description": "Authentication"
    },
    {
      "name": "admin",
      "description": "Admin API"
    }
  ],
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "description": "Аутентификация пользователя. Возвращает access-токен в header Authorization, refresh-токен в httpOnly cookie.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 3
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный вход",
            "headers": {
              "Authorization": {
                "schema": {
                  "type": "string"
                },
                "description": "Bearer <accessToken>"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "refreshToken=<token>; HttpOnly"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "firstName": {
                          "type": "string"
                        },
                        "lastName": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        }
                      },
                      "required": [
                        "id",
                        "firstName",
                        "lastName",
                        "email"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Неверные учётные данные"
          },
          "429": {
            "description": "Превышен rate limit"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "description": "Регистрация нового пользователя. Возвращает access-токен в header Authorization, refresh-токен в httpOnly cookie.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string",
                    "minLength": 2
                  },
                  "lastName": {
                    "type": "string",
                    "minLength": 2
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 3
                  }
                },
                "required": [
                  "firstName",
                  "lastName",
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Пользователь создан",
            "headers": {
              "Authorization": {
                "schema": {
                  "type": "string"
                },
                "description": "Bearer <accessToken>"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "refreshToken=<token>; HttpOnly"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "firstName": {
                          "type": "string"
                        },
                        "lastName": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        }
                      },
                      "required": [
                        "id",
                        "firstName",
                        "lastName",
                        "email"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Email уже занят"
          },
          "429": {
            "description": "Превышен rate limit"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "description": "Обновление access-токена через refresh-токен из cookie.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "refreshToken=<token>. httpOnly cookie, устанавливается сервером автоматически после успешного login/register в том же браузере. При тестировании через Swagger UI поле Cookie вручную заполнять не нужно — браузер сам передаст cookie (прочитать httpOnly-cookie из JS невозможно)."
            },
            "required": true,
            "description": "refreshToken=<token>. httpOnly cookie, устанавливается сервером автоматически после успешного login/register в том же браузере. При тестировании через Swagger UI поле Cookie вручную заполнять не нужно — браузер сам передаст cookie (прочитать httpOnly-cookie из JS невозможно).",
            "name": "Cookie",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Токен обновлён",
            "headers": {
              "Authorization": {
                "schema": {
                  "type": "string"
                },
                "description": "Bearer <accessToken>"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "refreshToken=<token>; HttpOnly"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "firstName": {
                          "type": "string"
                        },
                        "lastName": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        }
                      },
                      "required": [
                        "id",
                        "firstName",
                        "lastName",
                        "email"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Refresh-токен отсутствует, истёк или отозван"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "description": "Выход из аккаунта. Отзывает refresh-токен и очищает cookie.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "refreshToken=<token>. httpOnly cookie, устанавливается сервером автоматически после успешного login/register в том же браузере. При тестировании через Swagger UI поле Cookie вручную заполнять не нужно — браузер сам передаст cookie (прочитать httpOnly-cookie из JS невозможно)."
            },
            "required": true,
            "description": "refreshToken=<token>. httpOnly cookie, устанавливается сервером автоматически после успешного login/register в том же браузере. При тестировании через Swagger UI поле Cookie вручную заполнять не нужно — браузер сам передаст cookie (прочитать httpOnly-cookie из JS невозможно).",
            "name": "Cookie",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный выход",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Refresh-токен отсутствует"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "description": "Текущий пользователь по access-токену.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Bearer <accessToken>"
            },
            "required": true,
            "description": "Bearer <accessToken>",
            "name": "Authorization",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Данные текущего пользователя",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "firstName": {
                          "type": "string"
                        },
                        "lastName": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        }
                      },
                      "required": [
                        "id",
                        "firstName",
                        "lastName",
                        "email"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Не авторизован"
          }
        }
      }
    },
    "/products": {
      "get": {
        "tags": [
          "products"
        ],
        "description": "Каталог товаров с фильтрацией и пагинацией. Поддерживаются фильтры по brand (slug), category (slug), minPrice, maxPrice и динамическим атрибутам (любой ключ, не указанный в схеме, трактуется как атрибут: значения через запятую или повтор параметра).",
        "parameters": [
          {
            "schema": {
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": true,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": true,
              "default": 15
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "brand",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "category",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "nullable": true,
              "minimum": 0
            },
            "required": false,
            "name": "minPrice",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "nullable": true,
              "minimum": 0
            },
            "required": false,
            "name": "maxPrice",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Список товаров с pagination links",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number"
                          },
                          "title": {
                            "type": "string"
                          },
                          "slug": {
                            "type": "string"
                          },
                          "stock": {
                            "type": "number"
                          },
                          "brand": {
                            "type": "object",
                            "properties": {
                              "title": {
                                "type": "string"
                              },
                              "slug": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "title",
                              "slug"
                            ]
                          },
                          "category": {
                            "type": "object",
                            "properties": {
                              "title": {
                                "type": "string"
                              },
                              "slug": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "title",
                              "slug"
                            ]
                          },
                          "price": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "current": {
                                "type": "number"
                              },
                              "old": {
                                "type": "number",
                                "nullable": true
                              },
                              "discountPercent": {
                                "type": "number",
                                "nullable": true
                              }
                            },
                            "required": [
                              "current",
                              "old",
                              "discountPercent"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "title",
                          "slug",
                          "stock",
                          "brand",
                          "category",
                          "price"
                        ]
                      }
                    },
                    "links": {
                      "type": "object",
                      "properties": {
                        "self": {
                          "type": "string"
                        },
                        "prev": {
                          "type": "string",
                          "nullable": true
                        },
                        "next": {
                          "type": "string",
                          "nullable": true
                        },
                        "first": {
                          "type": "string"
                        },
                        "last": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "self",
                        "prev",
                        "next",
                        "first",
                        "last"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "links"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Ошибка валидации query-параметров"
          }
        }
      }
    },
    "/products/{slug}": {
      "get": {
        "tags": [
          "products"
        ],
        "description": "Детальная страница товара по slug. Включает атрибуты товара.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Slug товара"
            },
            "required": true,
            "description": "Slug товара",
            "name": "slug",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Товар найден",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "number"
                        },
                        "title": {
                          "type": "string"
                        },
                        "slug": {
                          "type": "string"
                        },
                        "stock": {
                          "type": "number"
                        },
                        "brand": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string"
                            },
                            "slug": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "title",
                            "slug"
                          ]
                        },
                        "category": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string"
                            },
                            "slug": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "title",
                            "slug"
                          ]
                        },
                        "price": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "current": {
                              "type": "number"
                            },
                            "old": {
                              "type": "number",
                              "nullable": true
                            },
                            "discountPercent": {
                              "type": "number",
                              "nullable": true
                            }
                          },
                          "required": [
                            "current",
                            "old",
                            "discountPercent"
                          ]
                        },
                        "attributes": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "title": {
                                "type": "string"
                              },
                              "value": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "title",
                              "value"
                            ]
                          }
                        }
                      },
                      "required": [
                        "id",
                        "title",
                        "slug",
                        "stock",
                        "brand",
                        "category",
                        "price",
                        "attributes"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Товар не найден"
          }
        }
      }
    }
  }
}