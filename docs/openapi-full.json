{
  "openapi": "3.0.0",
  "info": {
    "title": "techshopapi",
    "version": "2.0.0",
    "description": "API for techShop"
  },
  "servers": [
    {
      "url": "http://localhost:3030/api/v1"
    }
  ],
  "tags": [
    {
      "name": "store",
      "description": "Storefront API"
    },
    {
      "name": "auth",
      "description": "Authentication"
    },
    {
      "name": "admin",
      "description": "Admin API"
    }
  ],
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "description": "Аутентификация пользователя. Возвращает access-токен в header Authorization, refresh-токен в httpOnly cookie.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 3
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный вход",
            "headers": {
              "Authorization": {
                "schema": {
                  "type": "string"
                },
                "description": "Bearer <accessToken>"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "refreshToken=<token>; HttpOnly"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "firstName": {
                          "type": "string"
                        },
                        "lastName": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        }
                      },
                      "required": [
                        "id",
                        "firstName",
                        "lastName",
                        "email"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Неверные учётные данные"
          },
          "429": {
            "description": "Превышен rate limit"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "description": "Регистрация нового пользователя. Возвращает access-токен в header Authorization, refresh-токен в httpOnly cookie.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string",
                    "minLength": 2
                  },
                  "lastName": {
                    "type": "string",
                    "minLength": 2
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 3
                  }
                },
                "required": [
                  "firstName",
                  "lastName",
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Пользователь создан",
            "headers": {
              "Authorization": {
                "schema": {
                  "type": "string"
                },
                "description": "Bearer <accessToken>"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "refreshToken=<token>; HttpOnly"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "firstName": {
                          "type": "string"
                        },
                        "lastName": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        }
                      },
                      "required": [
                        "id",
                        "firstName",
                        "lastName",
                        "email"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Email уже занят"
          },
          "429": {
            "description": "Превышен rate limit"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "description": "Обновление access-токена через refresh-токен из cookie.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "refreshToken=<token>. httpOnly cookie, устанавливается сервером автоматически после успешного login/register в том же браузере. При тестировании через Swagger UI поле Cookie вручную заполнять не нужно — браузер сам передаст cookie (прочитать httpOnly-cookie из JS невозможно)."
            },
            "required": true,
            "description": "refreshToken=<token>. httpOnly cookie, устанавливается сервером автоматически после успешного login/register в том же браузере. При тестировании через Swagger UI поле Cookie вручную заполнять не нужно — браузер сам передаст cookie (прочитать httpOnly-cookie из JS невозможно).",
            "name": "Cookie",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Токен обновлён",
            "headers": {
              "Authorization": {
                "schema": {
                  "type": "string"
                },
                "description": "Bearer <accessToken>"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "refreshToken=<token>; HttpOnly"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "firstName": {
                          "type": "string"
                        },
                        "lastName": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        }
                      },
                      "required": [
                        "id",
                        "firstName",
                        "lastName",
                        "email"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Refresh-токен отсутствует, истёк или отозван"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "description": "Выход из аккаунта. Отзывает refresh-токен и очищает cookie.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "refreshToken=<token>. httpOnly cookie, устанавливается сервером автоматически после успешного login/register в том же браузере. При тестировании через Swagger UI поле Cookie вручную заполнять не нужно — браузер сам передаст cookie (прочитать httpOnly-cookie из JS невозможно)."
            },
            "required": true,
            "description": "refreshToken=<token>. httpOnly cookie, устанавливается сервером автоматически после успешного login/register в том же браузере. При тестировании через Swagger UI поле Cookie вручную заполнять не нужно — браузер сам передаст cookie (прочитать httpOnly-cookie из JS невозможно).",
            "name": "Cookie",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный выход",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Refresh-токен отсутствует"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "description": "Текущий пользователь по access-токену.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Bearer <accessToken>"
            },
            "required": true,
            "description": "Bearer <accessToken>",
            "name": "Authorization",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Данные текущего пользователя",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "firstName": {
                          "type": "string"
                        },
                        "lastName": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        }
                      },
                      "required": [
                        "id",
                        "firstName",
                        "lastName",
                        "email"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Не авторизован"
          }
        }
      }
    }
  }
}